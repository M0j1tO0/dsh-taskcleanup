{
  "name": "dsh-task-cleanup",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：每个轮次（turn）结束后回收任务级内存缓存、中间态对象、定时器、已结算 job 记录与过期临时文件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
